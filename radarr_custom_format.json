{
  "name": "Prefer HDR, Allow DV+HDR, Exclude DV-only",
  "includeCustomFormatWhenRenaming": false,
  "specifications": [
    {
      "name": "HDR present",
      "implementation": "ReleaseTitleSpecification",
      "negate": false,
      "required": true,
      "fields": {
        "value": "(?i)(?<![A-Za-z0-9])(?:HDR10(?:\\+|P(?:lus)?)?|HDRPlus|HDR)(?![A-Za-z0-9])"
      }
    },
    {
      "name": "Exclude DV-only (DV without HDR)",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "(?i)^(?!.*(?<![A-Za-z0-9])(?:HDR10(?:\\+|P(?:lus)?)?|HDRPlus|HDR)(?![A-Za-z0-9])).*(?<![A-Za-z0-9])(?:DV|DoVi|Dolby[ ._-]?Vision)(?![A-Za-z0-9])"
      }
    },
    {
      "name": "Not SDR",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "(?i)(?<![A-Za-z0-9])SDR(?![A-Za-z0-9])"
      }
    },
    {
      "name": "Not HLG",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "(?i)(?<![A-Za-z0-9])HLG(?![A-Za-z0-9])"
      }
    }
  ]
}
