{
  "name": "DV-only (no HDR fallback)",
  "includeCustomFormatWhenRenaming": false,
  "specifications": [
    {
      "name": "Dolby Vision without HDR anywhere in title",
      "implementation": "ReleaseTitleSpecification",
      "negate": false,
      "required": true,
      "fields": {
        "value": "(?i)^(?!.*(?<![A-Za-z0-9])(?:HDR10(?:\\+|P(?:lus)?)?|HDRPlus|HDR)(?![A-Za-z0-9])).*(?<![A-Za-z0-9])(?:DV|DoVi|Dolby[ ._-]?Vision)(?![A-Za-z0-9])"
      }
    }
  ]
}
