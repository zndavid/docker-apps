# =========================
# .env.example (template)
# =========================
# For Portainer, import your real values via Load variables from .env file.
# For local Compose, copy this file to .env and fill in real values.
# Keep comments on their own lines so shell tooling can parse values safely.
# Never commit your real .env file.

# ===== General =====
# IANA timezone name.
TZ=Europe/Vienna

# QNAP/NAS user and group IDs used by LinuxServer images.
PUID=1000
PGID=100

# ===== Shared media storage =====
# Set only after following docs/storage-migration.md. Must be an existing
# absolute NAS directory on one filesystem; no symlinked child shares.
MEDIA_STACK_DATA_ROOT=/share/MediaStack

# ===== qBittorrent + Gluetun / NordVPN =====
# WireGuard is the default VPN transport for the primary torrent stack.
GLUETUN_VPN_TYPE=wireguard
GLUETUN_WIREGUARD_PRIVATE_KEY=your_nordvpn_wireguard_private_key
GLUETUN_SERVER_COUNTRIES=Austria

# Only required if you deliberately switch GLUETUN_VPN_TYPE to openvpn.
# Use NordVPN service credentials, not the normal website login.
NORDVPN_USER=
NORDVPN_PASS=

# qBittorrent WebUI port published on the NAS for LAN access.
QBITTORRENT_WEBUI_PORT=18080

# qBittorrent listen port inside the VPN namespace. NordVPN does not provide
# inbound port forwarding, so this port is intentionally not published on the NAS.
QBITTORRENT_TORRENTING_PORT=6881

# ===== Cloudflare Tunnel =====
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ===== WUD =====
# LAN Web UI port. Sunday 12:00 scans notify; Docker updates are manual.
WUD_WEBUI_PORT=13000
# WUD v9 requires authentication. Import a real private password in Portainer.
# This placeholder is for config validation only and must not be deployed.
WUD_ADMIN_USER=admin
WUD_ADMIN_PASSWORD=replace_with_a_unique_private_password

# ===== Optional Jellyfin GPU override =====
# Used only with docker-compose.jellyfin-gpu.yml after NAS device checks.
# The QNAP J1900 uses legacy VAAPI/i965; newer Intel GPUs may need iHD.
JELLYFIN_LIBVA_DRIVER_NAME=i965

# ===== Telegram =====
# Used by WUD update notifications.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== Gmail SMTP =====
# Reserved for tooling that may send SMTP notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_username
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_from_address
SMTP_TO=recipient_email_address
