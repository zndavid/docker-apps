# =========================
# .env.example (template)
# =========================
# Copy this file to .env and fill in real values.
# Keep comments on their own lines so shell tooling can parse values safely.
# Never commit your real .env file.

# ===== General =====
# IANA timezone name.
TZ=Europe/Vienna

# QNAP/NAS user and group IDs used by LinuxServer images.
PUID=1000
PGID=100

# ===== qBittorrent + Gluetun / NordVPN =====
# WireGuard is the default VPN transport for the primary torrent stack.
GLUETUN_VPN_TYPE=wireguard
GLUETUN_WIREGUARD_PRIVATE_KEY=your_nordvpn_wireguard_private_key
GLUETUN_SERVER_COUNTRIES=Austria

# Only required if you deliberately switch GLUETUN_VPN_TYPE to openvpn.
# Use NordVPN service credentials, not the normal website login.
NORDVPN_USER=
NORDVPN_PASS=

# qBittorrent WebUI port published on the NAS for LAN access.
QBITTORRENT_WEBUI_PORT=18080

# qBittorrent listen port inside the VPN namespace. NordVPN does not provide
# inbound port forwarding, so this port is intentionally not published on the NAS.
QBITTORRENT_TORRENTING_PORT=6881

# ===== Calibre-Web Automated =====
# Local Web UI port for the ebook library and ingest service.
CWA_WEBUI_PORT=8083

# ===== Cloudflare Tunnel =====
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ===== WUD =====
# Local-only WUD Web UI port. Scheduled automatic checks/updates are configured
# in docker-compose.yml for Sundays at 12:00 Europe/Vienna time.
WUD_WEBUI_PORT=13000

# ===== Telegram =====
# Used by WUD update notifications.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== Gmail SMTP =====
# Reserved for tooling that may send SMTP notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_username
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_from_address
SMTP_TO=recipient_email_address
