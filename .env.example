# =========================
# .env.example (template)
# =========================
# Copy this file to .env and fill in real values.
# Keep comments on their own lines so shell tooling can parse values safely.
# Never commit your real .env file.

# ===== General =====
# IANA timezone name.
TZ=Europe/Vienna

# QNAP/NAS user and group IDs used by LinuxServer images.
PUID=1000
PGID=100

# ===== NordVPN / OpenVPN service credentials =====
# These are NordVPN service credentials, not the normal website login.
NORDVPN_USER=your_nordvpn_service_username
NORDVPN_PASS=your_nordvpn_service_password

# Transmission-OpenVPN country/profile selection.
OPENVPN_CONFIG_COUNTRIES=austria,switzerland,germany,slovakia,czech_republic,slovenia,hungary,italy,liechtenstein
NORDVPN_COUNTRY=AT

# ===== Local network =====
# LAN subnet used by the existing Transmission-OpenVPN stack.
LOCAL_NETWORK=192.168.178.0/24

# ===== Optional qBittorrent + Gluetun =====
# Recommended starting point is OpenVPN because it reuses the NordVPN service credentials above.
# NordVPN WireGuard is also supported by Gluetun if you provide a real NordVPN WireGuard private key.
GLUETUN_VPN_TYPE=openvpn
GLUETUN_WIREGUARD_PRIVATE_KEY=your_nordvpn_wireguard_private_key
GLUETUN_SERVER_COUNTRIES=Austria

# Host-side qBittorrent WebUI port. It is bound to 127.0.0.1 only.
QBITTORRENT_WEBUI_PORT=18080

# qBittorrent's internal listen port. NordVPN does not provide inbound port forwarding,
# so this port is intentionally not published on the Docker host for VPN ingress.
QBITTORRENT_TORRENTING_PORT=6881

# ===== Transmission RPC auth =====
TRANSMISSION_RPC_USER=your_rpc_username
TRANSMISSION_RPC_PASSWORD=your_rpc_password

# Native cleanup: stop idle seeding after 4 days.
TORRENT_IDLE_SEEDING_LIMIT_MINUTES=5760

# Optional overrides when the Transmission client is not ID 1 in Sonarr/Radarr.
SONARR_DOWNLOAD_CLIENT_ID=1
RADARR_DOWNLOAD_CLIENT_ID=1

# ===== Cloudflare Tunnel =====
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ===== Telegram =====
# Used by Diun update notifications and the cleanup helper success notification.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== Gmail SMTP =====
# Reserved for tooling that may send SMTP notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_username
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_from_address
SMTP_TO=recipient_email_address
